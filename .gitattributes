# Normalize line endings; keep PowerShell as CRLF for Windows tooling.
* text=auto eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary types (never diffed, and per .gitignore, normally not committed)
*.pcap binary
*.pcapng binary
*.png binary
*.bin binary
*.hex binary
